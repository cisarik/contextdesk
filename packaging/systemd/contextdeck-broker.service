[Unit]
Description=ContextDeck input broker (G213 passthrough)
Documentation=https://github.com/cisarik/contextdesk
# Starts disarmed and idle; later S4 leases arm it. Never enabled, never autostart.

[Service]
Type=notify
User=contextdeck-broker
Group=contextdeck-broker
# Fed from the broker event-loop thread only: READY=1 once the loop is
# running, WATCHDOG=1 after each wait return (including idle timeout) and
# after that iteration's work. A hung wait or hung ingest stops feeding.
# There is no notify helper thread. Do not raise this without changing the
# loop timeout (half of WatchdogSec).
WatchdogSec=2
Restart=no
LimitCORE=0
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# DeviceAllow only takes effect with a closed policy.
DevicePolicy=closed
DeviceAllow=/dev/uinput rw
DeviceAllow=char-input rw
RuntimeDirectory=contextdeck
RuntimeDirectoryMode=0750
# COOPERATOR adjusts the path until an install prefix exists.
ExecStart=/usr/bin/contextdeck-broker
# No [Install] section: do not enable this unit.
