# Grant G213 event nodes only to the contextdeck-broker identity; no other keyboards and no hidraw.
# /dev/uinput is not granted here: 73-seat-late.rules queues the uaccess builtin after this file,
# which would overwrite an earlier setfacl RUN. See 99-contextdeck-broker-uinput.rules.
SUBSYSTEM=="input", SUBSYSTEMS=="usb", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c336", KERNEL=="event*", GROUP="contextdeck-broker", MODE="0660"
